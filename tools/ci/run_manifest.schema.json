{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Run Manifest",
  "type": "object",
  "required": ["version", "runId", "inputs", "outputs"],
  "properties": {
    "version": { "type": "string" },
    "runId": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
